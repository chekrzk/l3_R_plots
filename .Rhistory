library(ggplot2)
library(plotly)
library(htmlwidgets)
library(DT)
url <- "https://raw.githubusercontent.com/Pozdniakov/tidy_stats/master/data/heroes_information.csv"
if (!file.exists("heroes.csv")) download.file(url, "heroes.csv", mode="wb")
df <- read.csv("heroes.csv", na.strings=c("-", "-99", "NA", ""), check.names=FALSE)
dir.create("r-assets", showWarnings=FALSE)
blocks <- character()
add <- function(title, code, path, widget=FALSE) {
escape <- function(x) gsub(">", "&gt;", gsub("<", "&lt;", gsub("&", "&amp;", x, fixed=TRUE), fixed=TRUE), fixed=TRUE)
media <- if(widget) sprintf('<iframe src="%s" loading="lazy" title="%s"></iframe>',path,title) else sprintf('<img src="%s" alt="%s">',path,title)
blocks <<- c(blocks,sprintf('<section><h2>%s</h2>%s<details><summary>R-код</summary><pre>%s</pre></details></section>',title,media,escape(code)))
}
static <- function(title, expr, id) {
path <- paste0("r-assets/",id,".png")
png(path,width=1000,height=650,res=120)
tryCatch(eval(expr, envir=.GlobalEnv),finally=dev.off())
add(title,paste(deparse(expr),collapse="\n"),path)
}
widget <- function(title, expr,id) {
path <- paste0("r-assets/",id,".html")
saveWidget(eval(expr,envir=.GlobalEnv),path,selfcontained=FALSE)
add(title,paste(deparse(expr),collapse="\n"),path,TRUE)
}
static("13.1 · Диаграмма рассеяния",quote(plot(df$Height,df$Weight)),"base-scatter")
static("13.1 · Матрица диаграмм iris",quote(plot(iris[,-5])),"iris-pairs")
for (b in c(4,30,100)) static(paste("13.2 · Гистограмма, breaks =",b),substitute(hist(df$Weight,breaks=B),list(B=b)),paste0("hist-",b))
static("13.3 · Ящик с усами",quote(boxplot(Weight~Gender,df)),"base-box")
p <- ggplot(df,aes(Height,Weight,colour=Gender))+geom_point(na.rm=TRUE)+theme_minimal()
static("14.2 · Эстетики и геометрии",quote(print(ggplot(df,aes(Height,Weight,colour=Gender))+geom_point(na.rm=TRUE)+theme_minimal())),"gg-scatter")
static("14.3 · Круговая диаграмма",quote(print(ggplot(subset(df,!is.na(Gender)),aes(x="",fill=Gender))+geom_bar()+coord_polar(theta="y")+theme_void())),"gg-pie")
static("14.4 · Слои и фасетки (пример на героях)",quote(print(ggplot(subset(df,!is.na(Gender)),aes(Height,Weight))+geom_point(na.rm=TRUE)+geom_smooth(method="lm",se=FALSE,na.rm=TRUE)+facet_wrap(~Gender)+theme_minimal())),"gg-layers")
widget("15.2 · ggplotly()",quote(ggplotly(p)),"ggplotly")
widget("15.2 · plot_ly()",quote(plot_ly(df,x=~Height,y=~Weight,color=~Gender,type="scatter",mode="markers")),"plotly")
widget("15 · Интерактивная таблица DT",quote(datatable(df,options=list(pageLength=10,scrollX=TRUE))),"table")
html <- c('<!doctype html><html lang="ru"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>R Visual Lab — отчёт R</title><style>body{max-width:1000px;margin:30px auto;padding:0 18px;background:#f4f6f9;color:#18263a;font:16px system-ui}section{background:white;border:1px solid #dce3eb;border-radius:12px;padding:20px;margin:20px 0}img{max-width:100%;height:auto}iframe{width:100%;height:540px;border:0}pre{white-space:pre-wrap;background:#eef2f6;padding:15px}a{color:#206b65}</style><a href="index.html">← Интерактивный конструктор</a><h1>Визуализации, построенные в R</h1><p>Учебный отчёт по главам 13–15. Данные: heroes_information и iris.</p>',blocks,'</html>')
writeLines(enc2utf8(html),"r-report.html",useBytes=TRUE)
