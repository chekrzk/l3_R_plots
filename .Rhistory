warning("use valid type", call. = FALSE)
}
trim <- function(x, n = 1) {
if (length(n) != 1 || is.na(n) ||
!is.numeric(n) || !is.finite(n) || n < 0) {
warning("n должно быть неотрицательным целым числом", call. = FALSE)
}
if (2 * n >= length(x)) {
warning("n слишком большое", call. = FALSE)
}
if (n == 0) {
return(x)
}
return(x[(n + 1):(length(x) - n)])
}
