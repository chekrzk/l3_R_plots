is_prime <- function(n) {
if (length(n) != 1 || is.na(n) || n < 2) {
return(FALSE)
}
if (n == 2) {
return(TRUE)
}
divisors <- 2:floor(sqrt(n))
return(!any(n %% divisors == 0))
}
monotone <- function(vec) {
for (num in 1:(length(vec) - 1)){
if (vec[num+1] < vec[num]){
return(FALSE)
}
}
return(TRUE)
}
